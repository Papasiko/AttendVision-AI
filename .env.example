# Copy this file to .env and replace every placeholder before starting Docker Compose.
# Generate unique values; do not reuse these placeholder strings.
ADMIN_API_TOKEN=replace-with-a-long-random-admin-secret
DEVICE_API_TOKEN=replace-with-a-different-long-random-device-secret
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

# Required only for biometric enrollment and matching. Generate with:
# python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BIOMETRIC_ENCRYPTION_KEY=

# Experimental starting value only; must be calibrated before any real evaluation.
FACE_MATCH_THRESHOLD=0.45
